# ==============================================================================
# FinZy Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase & PostgreSQL Connection
# ------------------------------------------------------------------------------
# Supabase API URL and anonymous key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Primary PostgreSQL database connection string
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54422/postgres
DIRECT_URL=postgres://postgres:postgres@127.0.0.1:54422/postgres

# Application Settings
APP_URL=http://localhost:3000
APP_NAME=FinZy
NODE_ENV=development

# ------------------------------------------------------------------------------
# Cron / Webhook Authentication
# ------------------------------------------------------------------------------
# Secret token for authenticating background cron triggers (/api/cron/recurring, /api/cron/valuations)
CRON_SECRET=change-this-to-a-secure-random-secret-in-production
