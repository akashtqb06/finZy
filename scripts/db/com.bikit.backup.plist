<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bikit.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/akashsaravanan/Development/bi-kit/scripts/db/backup-live.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/akashsaravanan/Development/bi-kit</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Place your direct URL and age public recipient here or in your shell environment -->
        <!-- <key>DIRECT_URL</key> -->
        <!-- <string>postgres://...</string> -->
        <!-- <key>BACKUP_AGE_RECIPIENT</key> -->
        <!-- <string>age1...</string> -->
    </dict>

    <!-- Run every day at 02:00 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/akashsaravanan/Development/bi-kit/backups/backup.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/akashsaravanan/Development/bi-kit/backups/backup.error.log</string>
</dict>
</plist>
