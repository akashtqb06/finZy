# ==============================================================================
# Finzy Production Environment Configuration (.env.production.example)
# Use this template for production deployment (e.g., Vercel + Supabase Cloud).
# Note: Never commit production credentials or service-role keys.
# ==============================================================================

# Supabase Project Configuration
# Found in: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Public API Key (Anon / Publishable)
# Found in: Project Settings -> API -> Project API keys -> "anon" / "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Runtime Database Connection (Transaction Pooler - Port 6543)
# Used by the serverless application runtime with connection pooling.
DATABASE_URL=postgres://postgres.<your-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Direct Database Connection (Direct / Session Pooler - Port 5432)
# Used ONLY out-of-band for migrations (`pnpm db:migrate`) and CLI scripts.
# NEVER run migrations during the Vercel build.
DIRECT_URL=postgres://postgres.<your-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Application Host & Metadata
APP_URL=https://finzy.example.com
APP_NAME=Finzy

# Internal Cron Authentication Secret (Generate with: openssl rand -hex 32)
CRON_SECRET=replace_with_strong_random_secret_32_chars
