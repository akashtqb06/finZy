# ==============================================================================
# Finzy Local Development Environment (.env.local.example)
# Copy this file to .env.local for local development against the Supabase stack.
# Run `pnpm db:start` to spin up local Supabase, then `pnpm dev:user` to create a dev user.
# Ports are in the 5442x range to avoid collisions with other projects (e.g. 5432x).
# ==============================================================================

# Supabase Local Stack (Kong API Gateway on port 54421)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Local stack anon/public key (shown by `pnpm db:status`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODMxOTI0MDAsImlhdCI6MTY2NzU2MDQwMH0.XXXX

# Local Postgres Database (port 54422)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54422/postgres
DIRECT_URL=postgres://postgres:postgres@127.0.0.1:54422/postgres

# Application Settings
APP_URL=http://localhost:3000
APP_NAME=FinZy

# Background Cron Secret (for /api/cron/* jobs)
CRON_SECRET=local_dev_cron_secret_32_characters_long
